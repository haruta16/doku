; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Meowdoku"
config/version="1.22.0"
run/main_scene="res://launcher.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Meowdoku-Recovered-1.22.0"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0.969, 0.949, 0.933, 1)
boot_splash/image="res://assets/icons/ios_launch_3x.png"
config/icon="res://icon.png"
run/disable_stdout.rel=true

[autoload]

NativeUtilManager="*res://scripts/common/native_util_manager.gd"
EventBus="*res://scripts/module/event_bus/event_bus.gd"
GameState="*res://scripts/module/game_state/game_state.gd"
SoundManager="*res://scripts/module/sound/sound_manager.gd"
UIManager="*res://scripts/module/ui/ui_manager.gd"
CheatBus="*res://scripts/module/cheat/cheat_bus.gd"
UniKit="*res://addons/unikit/scripts/unikit.gd"
UniKitManager="*res://scripts/common/unikit_manager.gd"
PurchaseManager="*res://scripts/module/purchase/purchase_manager.gd"
SessionManager="*res://scripts/module/session/session_manager.gd"
Tracker="*res://scripts/module/tracker/tracker.gd"
ABTestManager="*res://scripts/module/abtest/abtest_manager.gd"
StreakManager="*res://scripts/module/daily_streak/core/feature_daily_streak.gd"
LanguageManager="*res://scripts/module/language/language_manager.gd"
ScreenManager="*res://scripts/module/common/screen_manager.gd"
SpineIdleGuard="*res://scripts/module/common/spine_idle_guard.gd"
PowerSaver="*res://scripts/module/common/power_saver.gd"
AwardManager="*res://scripts/module/award/award_manager.gd"
HomeSettingAnchor="*res://scripts/module/ui/home_setting_anchor.gd"
HelpshiftManager="*res://scripts/common/helpshift_manager.gd"
RedDotCenter="*res://scripts/module/ui/red_dot/red_dot_center.gd"
RobotService="*res://scripts/module/robot/robot_service.gd"
ProfileService="*res://scripts/module/profile/profile_service.gd"
RankActivityManager="*res://scripts/module/rank_activity/rank_activity_manager.gd"
ClockTicker="*res://scripts/module/ui/clock_ticker.gd"
LXAuth="*res://addons/lxlogin/scripts/lx_auth.gd"
AuthManager="*res://scripts/common/auth_manager.gd"
DataSyncManager="*res://scripts/module/data_sync/data_sync_manager.gd"
AccountManager="*res://scripts/module/account/account_manager.gd"
LevelRecManager="*res://scripts/module/level_rec/level_rec_manager.gd"
PeekabooManager="*res://scripts/module/peekaboo/peekaboo_manager.gd"
DcProbe="*res://scripts/module/debug/dc_probe.gd"

[debug]

settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=1080
window/size/viewport_height=2400
window/size/window_width_override=1080
window/size/window_height_override=2400
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Meowdoku"

[editor_overrides]

text_editor/behavior/indent/type=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/helpshift_plugin/plugin.cfg", "res://addons/in_app_review_plugin/plugin.cfg", "res://addons/level_bank_encryptor/plugin.cfg", "res://addons/recovery_android_export/plugin.cfg", "res://addons/vibrate_plugin/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/Roboto.ttf"

[importer_defaults]

texture={
&"compress/high_quality": true,
&"compress/mode": 2
}

[internationalization]

rendering/root_node_layout_direction=1
locale/translations=PackedStringArray("res://assets/localization/translations.en.translation", "res://assets/localization/translations.zh_CN.translation", "res://assets/localization/translations.pt_BR.translation", "res://assets/localization/translations.hi.translation", "res://assets/localization/translations.id.translation", "res://assets/localization/translations.fil.translation", "res://assets/localization/translations.zh_TW.translation", "res://assets/localization/translations.ru.translation", "res://assets/localization/translations.ja.translation", "res://assets/localization/translations.de.translation", "res://assets/localization/translations.fr.translation", "res://assets/localization/translations.ko.translation", "res://assets/localization/translations.pt.translation", "res://assets/localization/translations.es.translation", "res://assets/localization/translations.az.translation", "res://assets/localization/translations.be.translation", "res://assets/localization/translations.hr.translation", "res://assets/localization/translations.cs.translation", "res://assets/localization/translations.da.translation", "res://assets/localization/translations.ar_EG.translation", "res://assets/localization/translations.fi.translation", "res://assets/localization/translations.el.translation", "res://assets/localization/translations.hu.translation", "res://assets/localization/translations.fa.translation", "res://assets/localization/translations.he.translation", "res://assets/localization/translations.it.translation", "res://assets/localization/translations.ar_LB.translation", "res://assets/localization/translations.lt.translation", "res://assets/localization/translations.ms.translation", "res://assets/localization/translations.ar_MA.translation", "res://assets/localization/translations.nl_NL.translation", "res://assets/localization/translations.nb.translation", "res://assets/localization/translations.ar_OM.translation", "res://assets/localization/translations.en_PH.translatio