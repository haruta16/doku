; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Meowdoku"
config/version="1.22.0"
run/main_scene="res://products/meowdoku/launcher.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Meowdoku-Recovered-1.22.0"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0.969, 0.949, 0.933, 1)
boot_splash/image="res://products/meowdoku/assets/icons/ios_launch_3x.png"
config/icon="res://products/meowdoku/assets/icons/project_icon.png"
run/disable_stdout.rel=true

[autoload]

ContentRuntime="*res://products/meowdoku/app/bootstrap/content_bootstrap.gd"

NativeUtilManager="*res://products/meowdoku/app/platform/native_util_manager.gd"
EventBus="*res://products/meowdoku/app/services/event_bus.gd"
GameState="*res://products/meowdoku/app/state/game_state.gd"
SoundManager="*res://products/meowdoku/app/services/sound_manager.gd"
UIManager="*res://products/meowdoku/app/ui/ui_manager.gd"
CheatBus="*res://addons/cheat_manager/cheat_bus.gd"
UniKit="*res://addons/unikit/scripts/unikit.gd"
UniKitManager="*res://products/meowdoku/app/platform/unikit_manager.gd"
PurchaseManager="*res://products/meowdoku/app/features/purchase/purchase_manager.gd"
SessionManager="*res://products/meowdoku/app/services/session_manager.gd"
Tracker="*res://products/meowdoku/app/services/tracker.gd"
ABTestManager="*res://products/meowdoku/app/features/abtest/abtest_manager.gd"
StreakManager="*res://products/meowdoku/app/features/daily_streak/core/feature_daily_streak.gd"
LanguageManager="*res://products/meowdoku/app/features/language/language_manager.gd"
ScreenManager="*res://products/meowdoku/app/platform/screen_manager.gd"
SpineIdleGuard="*res://products/meowdoku/app/platform/spine_idle_guard.gd"
PowerSaver="*res://products/meowdoku/app/platform/power_saver.gd"
AwardManager="*res://products/meowdoku/app/features/award/award_manager.gd"
HomeSettingAnchor="*res://products/meowdoku/app/ui/home_setting_anchor.gd"
HelpshiftManager="*res://products/meowdoku/app/platform/helpshift_manager.gd"
RedDotCenter="*res://products/meowdoku/app/ui/red_dot_center.gd"
RobotService="*res://products/meowdoku/app/features/robot/robot_service.gd"
ProfileService="*res://products/meowdoku/app/features/profile/profile_service.gd"
RankActivityManager="*res://products/meowdoku/app/features/rank_activity/rank_activity_manager.gd"
ClockTicker="*res://products/meowdoku/app/ui/clock_ticker.gd"
LXAuth="*res://addons/lxlogin/scripts/lx_auth.gd"
AuthManager="*res://products/meowdoku/app/platform/auth_manager.gd"
DataSyncManager="*res://products/meowdoku/app/features/data_sync/data_sync_manager.gd"
AccountManager="*res://products/meowdoku/app/features/account/account_manager.gd"
LevelRecManager="*res://products/meowdoku/app/features/level_rec/level_rec_manager.gd"
PeekabooManager="*res://products/meowdoku/app/features/peekaboo/peekaboo_manager.gd"
DcProbe="*res://products/meowdoku/app/diagnostics/dc_probe.gd"
MCPScreenshot="*res://addons/godot_mcp/mcp_screenshot_service.gd"
MCPInputService="*res://addons/godot_mcp/mcp_input_service.gd"
MCPGameInspector="*res://addons/godot_mcp/mcp_game_inspector_service.gd"

[content]

product="meowdoku"
runtime_id="godot-4.6.1-spine-4.2-data-v2"
validator_script="res://products/meowdoku/gameplay/content/doku_content_validator.gd"
scene_bindings_path="res://products/meowdoku/assets/config/scene_bindings.json"
public_key_path=""
channel="stable"
channel_url=""
release_url=""
release_id=""
release_manifest_sha256=""
allow_local_http=false

[debug]

settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=1080
window/size/viewport_height=2400
window/size/window_width_override=1080
window/size/window_height_override=2400
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Meowdoku"

[editor_overrides]

text_editor/behavior/indent/type=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/helpshift_plugin/plugin.cfg", "res://addons/in_app_review_plugin/plugin.cfg", "res://addons/level_bank_encryptor/plugin.cfg", "res://addons/recovery_android_export/plugin.cfg", "res://addons/vibrate_plugin/plugin.cfg")

[gui]

theme/custom_font="res://products/meowdoku/assets/fonts/Roboto.ttf"

[importer_defaults]

texture={
&"compress/high_quality": true,
&"compress/mode": 2
}

