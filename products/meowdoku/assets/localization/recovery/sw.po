msgid "RECOVERY_RESULT_TITLE"
msgstr "Matokeo hayajahifadhiwa"

msgid "RECOVERY_RESULT_BODY"
msgstr "Jaribu kuhifadhi matokeo haya tena. Ukifunga utarudi kwenye ukurasa mkuu; matokeo ambayo hayajahifadhiwa yanaweza kupotea."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Kuingia kwa kila siku hakujahifadhiwa"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Ushindi wako umehifadhiwa. Jaribu kuingia kwa kila siku tena, au funga ili kuruka hatua hii kwa sasa."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Maudhui ya mchezo hayakuweza kupakiwa. Tafadhali anzisha mchezo upya."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Kitendo hakikuweza kuhifadhiwa. Tafadhali jaribu tena."
