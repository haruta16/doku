msgid "RECOVERY_RESULT_TITLE"
msgstr "Resultatet blev ikke gemt"

msgid "RECOVERY_RESULT_BODY"
msgstr "Prøv at gemme dette resultat igen. Hvis du lukker, vender du tilbage til startskærmen; resultater, der ikke er gemt, kan gå tabt."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Dagligt check-in blev ikke gemt"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Din sejr er gemt. Prøv det daglige check-in igen, eller luk for at springe det over denne gang."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Spilindholdet kunne ikke indlæses. Genstart spillet."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Handlingen kunne ikke gemmes. Prøv igen."
