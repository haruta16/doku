msgid "RECOVERY_RESULT_TITLE"
msgstr "Nəticə saxlanılmadı"

msgid "RECOVERY_RESULT_BODY"
msgstr "Bu nəticəni yenidən saxlamağa çalışın. Bağladıqda əsas ekrana qayıdacaqsınız; saxlanılmamış nəticələr itə bilər."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Gündəlik giriş saxlanılmadı"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Qələbəniz saxlanılıb. Gündəlik girişi yenidən sınayın və ya bu dəfə ötürmək üçün bağlayın."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Oyunun məzmununu yükləmək mümkün olmadı. Oyunu yenidən başladın."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Əməliyyatı saxlamaq mümkün olmadı. Yenidən cəhd edin."
