msgid "RECOVERY_RESULT_TITLE"
msgstr "Rezultat nije sačuvan"

msgid "RECOVERY_RESULT_BODY"
msgstr "Pokušajte ponovo sačuvati ovaj rezultat. Zatvaranjem se vraćate na početni ekran; nesačuvani rezultati mogu biti izgubljeni."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Dnevna prijava nije sačuvana"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Vaša pobjeda je sačuvana. Ponovite dnevnu prijavu ili zatvorite da biste je ovaj put preskočili."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Sadržaj igre nije se mogao učitati. Ponovo pokrenite igru."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Radnja se nije mogla sačuvati. Pokušajte ponovo."
