msgid "RECOVERY_RESULT_TITLE"
msgstr "نتیجہ محفوظ نہیں ہوا"

msgid "RECOVERY_RESULT_BODY"
msgstr "اس نتیجے کو دوبارہ محفوظ کرنے کی کوشش کریں۔ بند کرنے پر ہوم پر واپس جائیں گے؛ غیر محفوظ نتائج ضائع ہو سکتے ہیں۔"

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "روزانہ چیک اِن محفوظ نہیں ہوا"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "آپ کی جیت محفوظ ہو گئی ہے۔ روزانہ چیک اِن دوبارہ کریں، یا اس بار چھوڑنے کے لیے بند کریں۔"

msgid "RECOVERY_CONTENT_ERROR"
msgstr "گیم کا مواد لوڈ نہیں ہو سکا۔ براہِ کرم گیم دوبارہ شروع کریں۔"

msgid "RECOVERY_SAVE_ERROR"
msgstr "عمل محفوظ نہیں ہو سکا۔ براہِ کرم دوبارہ کوشش کریں۔"
