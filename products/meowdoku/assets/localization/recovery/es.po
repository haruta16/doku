msgid "RECOVERY_RESULT_TITLE"
msgstr "Resultado no guardado"

msgid "RECOVERY_RESULT_BODY"
msgstr "Vuelve a intentar guardar este resultado. Al cerrar volverás al inicio; los resultados no guardados podrían perderse."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Registro diario no guardado"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Tu victoria está guardada. Reintenta el registro diario o cierra para omitirlo esta vez."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "No se pudo cargar el contenido del juego. Reinicia el juego."

msgid "RECOVERY_SAVE_ERROR"
msgstr "No se pudo guardar la acción. Vuelve a intentarlo."
