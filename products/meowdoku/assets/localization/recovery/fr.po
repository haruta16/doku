msgid "RECOVERY_RESULT_TITLE"
msgstr "Résultat non enregistré"

msgid "RECOVERY_RESULT_BODY"
msgstr "Réessayez d’enregistrer ce résultat. Fermer vous ramènera à l’accueil ; les résultats non enregistrés risquent d’être perdus."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Connexion quotidienne non enregistrée"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Votre victoire est enregistrée. Réessayez de valider la connexion quotidienne, ou fermez pour l’ignorer cette fois-ci."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Impossible de charger le contenu du jeu. Veuillez redémarrer le jeu."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Impossible d’enregistrer cette action. Veuillez réessayer."
