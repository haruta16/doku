msgid "RECOVERY_RESULT_TITLE"
msgstr "Resultatet ble ikke lagret"

msgid "RECOVERY_RESULT_BODY"
msgstr "Prøv å lagre dette resultatet på nytt. Hvis du lukker, kommer du tilbake til startskjermen; resultater som ikke er lagret, kan gå tapt."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Daglig innsjekking ble ikke lagret"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Seieren din er lagret. Prøv den daglige innsjekkingen på nytt, eller lukk for å hoppe over den denne gangen."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Spillinnholdet kunne ikke lastes inn. Start spillet på nytt."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Handlingen kunne ikke lagres. Prøv igjen."
