msgid "RECOVERY_RESULT_TITLE"
msgstr "Ergebnis nicht gespeichert"

msgid "RECOVERY_RESULT_BODY"
msgstr "Versuche erneut, dieses Ergebnis zu speichern. Beim Schließen kehrst du zur Startseite zurück; nicht gespeicherte Ergebnisse können verloren gehen."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Täglicher Check-in nicht gespeichert"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Dein Sieg ist gespeichert. Versuche den täglichen Check-in erneut oder schließe das Fenster, um ihn diesmal zu überspringen."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Der Spielinhalt konnte nicht geladen werden. Bitte starte das Spiel neu."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Die Aktion konnte nicht gespeichert werden. Bitte versuche es erneut."
