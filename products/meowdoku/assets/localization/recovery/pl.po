msgid "RECOVERY_RESULT_TITLE"
msgstr "Wynik nie został zapisany"

msgid "RECOVERY_RESULT_BODY"
msgstr "Spróbuj ponownie zapisać ten wynik. Zamknięcie spowoduje powrót do ekranu głównego; niezapisane wyniki mogą zostać utracone."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Codzienne logowanie nie zostało zapisane"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Twoje zwycięstwo zostało zapisane. Ponów codzienne logowanie lub zamknij okno, aby tym razem je pominąć."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Nie udało się wczytać zawartości gry. Uruchom grę ponownie."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Nie udało się zapisać działania. Spróbuj ponownie."
