msgid "RECOVERY_RESULT_TITLE"
msgstr "ಫಲಿತಾಂಶ ಉಳಿಸಲಾಗಿಲ್ಲ"

msgid "RECOVERY_RESULT_BODY"
msgstr "ಈ ಫಲಿತಾಂಶವನ್ನು ಮತ್ತೆ ಉಳಿಸಲು ಪ್ರಯತ್ನಿಸಿ. ಮುಚ್ಚಿದರೆ ಮುಖಪುಟಕ್ಕೆ ಹಿಂತಿರುಗುತ್ತೀರಿ; ಉಳಿಸದ ಫಲಿತಾಂಶಗಳು ಕಳೆದುಹೋಗಬಹುದು."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "ದೈನಂದಿನ ಚೆಕ್-ಇನ್ ಉಳಿಸಲಾಗಿಲ್ಲ"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "ನಿಮ್ಮ ಗೆಲುವನ್ನು ಉಳಿಸಲಾಗಿದೆ. ದೈನಂದಿನ ಚೆಕ್-ಇನ್ ಅನ್ನು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ ಈ ಬಾರಿ ಅದನ್ನು ಬಿಟ್ಟುಬಿಡಲು ಮುಚ್ಚಿ."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "ಆಟದ ವಿಷಯವನ್ನು ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಆಟವನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ."

msgid "RECOVERY_SAVE_ERROR"
msgstr "ಕ್ರಿಯೆಯನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
