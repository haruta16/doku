msgid "RECOVERY_RESULT_TITLE"
msgstr "Hindi na-save ang resulta"

msgid "RECOVERY_RESULT_BODY"
msgstr "Subukang i-save muli ang resultang ito. Kapag isinara, babalik ka sa home; maaaring mawala ang mga resultang hindi na-save."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Hindi na-save ang araw-araw na check-in"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Na-save na ang panalo mo. Subukan muli ang check-in, o isara para laktawan ito sa pagkakataong ito."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Hindi ma-load ang nilalaman ng laro. Pakisimulan muli ang laro."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Hindi na-save ang aksyon. Pakisubukan muli."
