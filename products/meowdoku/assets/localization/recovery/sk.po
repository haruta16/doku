msgid "RECOVERY_RESULT_TITLE"
msgstr "Výsledok nebol uložený"

msgid "RECOVERY_RESULT_BODY"
msgstr "Skúste tento výsledok uložiť znova. Zatvorením sa vrátite na úvodnú obrazovku; neuložené výsledky sa môžu stratiť."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Denné prihlásenie nebolo uložené"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Vaša výhra je uložená. Skúste denné prihlásenie znova alebo okno zatvorte a tentoraz ho preskočte."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Obsah hry sa nepodarilo načítať. Reštartujte hru."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Akciu sa nepodarilo uložiť. Skúste to znova."
