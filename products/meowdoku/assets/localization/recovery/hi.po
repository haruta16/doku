msgid "RECOVERY_RESULT_TITLE"
msgstr "नतीजा सेव नहीं हुआ"

msgid "RECOVERY_RESULT_BODY"
msgstr "इस नतीजे को दोबारा सेव करने की कोशिश करें। बंद करने पर होम पर लौटेंगे; सेव न हुए नतीजे खो सकते हैं।"

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "दैनिक चेक-इन सेव नहीं हुआ"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "आपकी जीत सेव हो गई है। दैनिक चेक-इन फिर से करें या इस बार इसे छोड़ने के लिए बंद करें।"

msgid "RECOVERY_CONTENT_ERROR"
msgstr "गेम का कॉन्टेंट लोड नहीं हो सका। कृपया गेम फिर से शुरू करें।"

msgid "RECOVERY_SAVE_ERROR"
msgstr "कार्रवाई सेव नहीं हो सकी। कृपया फिर से कोशिश करें।"
