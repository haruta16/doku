msgid "RECOVERY_RESULT_TITLE"
msgstr "התוצאה לא נשמרה"

msgid "RECOVERY_RESULT_BODY"
msgstr "נסו לשמור את התוצאה שוב. סגירה תחזיר אתכם למסך הבית; תוצאות שלא נשמרו עלולות ללכת לאיבוד."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "הכניסה היומית לא נשמרה"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "הניצחון שלכם נשמר. נסו שוב את הכניסה היומית, או סגרו כדי לדלג עליה הפעם."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "לא ניתן היה לטעון את תוכן המשחק. הפעילו מחדש את המשחק."

msgid "RECOVERY_SAVE_ERROR"
msgstr "לא ניתן היה לשמור את הפעולה. נסו שוב."
