msgid "RECOVERY_RESULT_TITLE"
msgstr "Hasil belum tersimpan"

msgid "RECOVERY_RESULT_BODY"
msgstr "Coba simpan hasil ini lagi. Menutup akan membawamu ke beranda; hasil yang belum tersimpan bisa hilang."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Check-in harian belum tersimpan"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Kemenanganmu sudah tersimpan. Coba check-in harian lagi, atau tutup untuk melewatinya kali ini."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Konten game tidak dapat dimuat. Silakan mulai ulang game."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Tindakan tidak dapat disimpan. Silakan coba lagi."
