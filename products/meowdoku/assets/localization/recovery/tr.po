msgid "RECOVERY_RESULT_TITLE"
msgstr "Sonuç kaydedilmedi"

msgid "RECOVERY_RESULT_BODY"
msgstr "Bu sonucu kaydetmeyi tekrar dene. Kapatırsan ana ekrana dönersin; kaydedilmeyen sonuçlar kaybolabilir."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Günlük giriş kaydedilmedi"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Galibiyetin kaydedildi. Günlük girişi tekrar dene veya bu seferlik atlamak için kapat."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Oyun içeriği yüklenemedi. Lütfen oyunu yeniden başlat."

msgid "RECOVERY_SAVE_ERROR"
msgstr "İşlem kaydedilemedi. Lütfen tekrar dene."
