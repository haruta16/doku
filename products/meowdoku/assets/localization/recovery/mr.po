msgid "RECOVERY_RESULT_TITLE"
msgstr "निकाल सेव्ह झाला नाही"

msgid "RECOVERY_RESULT_BODY"
msgstr "हा निकाल पुन्हा सेव्ह करण्याचा प्रयत्न करा. बंद केल्यावर होमवर परत जाल; सेव्ह न केलेले निकाल गमावले जाऊ शकतात."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "दैनिक चेक-इन सेव्ह झाले नाही"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "तुमचा विजय सेव्ह झाला आहे. दैनिक चेक-इन पुन्हा करा किंवा या वेळी ते वगळण्यासाठी बंद करा."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "गेमचा आशय लोड होऊ शकला नाही. कृपया गेम पुन्हा सुरू करा."

msgid "RECOVERY_SAVE_ERROR"
msgstr "कृती सेव्ह होऊ शकली नाही. कृपया पुन्हा प्रयत्न करा."
