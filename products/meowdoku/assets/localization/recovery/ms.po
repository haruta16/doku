msgid "RECOVERY_RESULT_TITLE"
msgstr "Keputusan tidak disimpan"

msgid "RECOVERY_RESULT_BODY"
msgstr "Cuba simpan keputusan ini sekali lagi. Menutup akan membawa anda ke halaman utama; keputusan yang belum disimpan mungkin hilang."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Daftar masuk harian tidak disimpan"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Kemenangan anda telah disimpan. Cuba daftar masuk harian sekali lagi, atau tutup untuk melangkaunya kali ini."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Kandungan permainan tidak dapat dimuatkan. Sila mulakan semula permainan."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Tindakan tidak dapat disimpan. Sila cuba lagi."
