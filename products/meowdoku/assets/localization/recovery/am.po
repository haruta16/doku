msgid "RECOVERY_RESULT_TITLE"
msgstr "ውጤቱ አልተቀመጠም"

msgid "RECOVERY_RESULT_BODY"
msgstr "ይህን ውጤት እንደገና ለማስቀመጥ ይሞክሩ። ሲዘጉ ወደ ዋናው ገጽ ይመለሳሉ፤ ያልተቀመጡ ውጤቶች ሊጠፉ ይችላሉ።"

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "የዕለቱ መግቢያ አልተቀመጠም"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "ድልዎ ተቀምጧል። የዕለቱን መግቢያ እንደገና ይሞክሩ፣ ወይም በዚህ ጊዜ ለመዝለል ይዝጉ።"

msgid "RECOVERY_CONTENT_ERROR"
msgstr "የጨዋታውን ይዘት መጫን አልተቻለም። እባክዎ ጨዋታውን እንደገና ያስጀምሩ።"

msgid "RECOVERY_SAVE_ERROR"
msgstr "እርምጃውን ማስቀመጥ አልተቻለም። እባክዎ እንደገና ይሞክሩ።"
