msgid "RECOVERY_RESULT_TITLE"
msgstr "પરિણામ સેવ થયું નથી"

msgid "RECOVERY_RESULT_BODY"
msgstr "આ પરિણામ ફરીથી સેવ કરવાનો પ્રયાસ કરો. બંધ કરવાથી હોમ પર પાછા જશો; સેવ ન થયેલાં પરિણામો ખોવાઈ શકે છે."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "દૈનિક ચેક-ઇન સેવ થયું નથી"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "તમારી જીત સેવ થઈ ગઈ છે. દૈનિક ચેક-ઇન ફરીથી કરો અથવા આ વખતે તેને છોડવા માટે બંધ કરો."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "ગેમનું કન્ટેન્ટ લોડ થઈ શક્યું નથી. કૃપા કરીને ગેમ ફરીથી શરૂ કરો."

msgid "RECOVERY_SAVE_ERROR"
msgstr "ક્રિયા સેવ થઈ શકી નથી. કૃપા કરીને ફરી પ્રયાસ કરો."
