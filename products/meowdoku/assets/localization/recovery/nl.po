msgid "RECOVERY_RESULT_TITLE"
msgstr "Resultaat niet opgeslagen"

msgid "RECOVERY_RESULT_BODY"
msgstr "Probeer dit resultaat opnieuw op te slaan. Door te sluiten ga je terug naar het beginscherm; niet-opgeslagen resultaten kunnen verloren gaan."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Dagelijkse check-in niet opgeslagen"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Je overwinning is opgeslagen. Probeer de dagelijkse check-in opnieuw of sluit om deze keer over te slaan."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "De spelinhoud kon niet worden geladen. Start het spel opnieuw."

msgid "RECOVERY_SAVE_ERROR"
msgstr "De actie kon niet worden opgeslagen. Probeer het opnieuw."
