msgid "RECOVERY_RESULT_TITLE"
msgstr "Výsledek nebyl uložen"

msgid "RECOVERY_RESULT_BODY"
msgstr "Zkuste tento výsledek uložit znovu. Zavřením se vrátíte na úvodní obrazovku; neuložené výsledky mohou být ztraceny."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Denní přihlášení nebylo uloženo"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Vaše výhra je uložena. Zkuste denní přihlášení znovu nebo okno zavřete a tentokrát ho přeskočte."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Obsah hry se nepodařilo načíst. Restartujte hru."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Akci se nepodařilo uložit. Zkuste to znovu."
