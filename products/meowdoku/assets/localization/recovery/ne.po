msgid "RECOVERY_RESULT_TITLE"
msgstr "नतिजा सेभ भएन"

msgid "RECOVERY_RESULT_BODY"
msgstr "यो नतिजा फेरि सेभ गर्ने प्रयास गर्नुहोस्। बन्द गर्दा होममा फर्कनुहुनेछ; सेभ नभएका नतिजाहरू हराउन सक्छन्।"

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "दैनिक चेक-इन सेभ भएन"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "तपाईंको जित सेभ भएको छ। दैनिक चेक-इन फेरि प्रयास गर्नुहोस् वा यस पटक छोड्न बन्द गर्नुहोस्।"

msgid "RECOVERY_CONTENT_ERROR"
msgstr "गेमको सामग्री लोड गर्न सकिएन। कृपया गेम फेरि सुरु गर्नुहोस्।"

msgid "RECOVERY_SAVE_ERROR"
msgstr "कार्य सेभ गर्न सकिएन। कृपया फेरि प्रयास गर्नुहोस्।"
