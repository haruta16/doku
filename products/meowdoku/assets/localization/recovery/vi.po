msgid "RECOVERY_RESULT_TITLE"
msgstr "Chưa lưu được kết quả"

msgid "RECOVERY_RESULT_BODY"
msgstr "Hãy thử lưu lại kết quả này. Đóng sẽ đưa bạn về trang chủ; kết quả chưa lưu có thể bị mất."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Chưa lưu được điểm danh"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Chiến thắng của bạn đã được lưu. Hãy thử điểm danh lại hoặc đóng để bỏ qua lần điểm danh này."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Không thể tải nội dung trò chơi. Vui lòng khởi động lại trò chơi."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Không thể lưu thao tác. Vui lòng thử lại."
