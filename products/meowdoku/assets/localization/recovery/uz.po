msgid "RECOVERY_RESULT_TITLE"
msgstr "Natija saqlanmadi"

msgid "RECOVERY_RESULT_BODY"
msgstr "Bu natijani yana saqlashga urinib ko‘ring. Yopsangiz, bosh ekranga qaytasiz; saqlanmagan natijalar yo‘qolishi mumkin."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Kundalik kirish saqlanmadi"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "G‘alabangiz saqlandi. Kundalik kirishni qayta bajaring yoki bu safar o‘tkazib yuborish uchun yoping."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "O‘yin mazmunini yuklab bo‘lmadi. O‘yinni qayta ishga tushiring."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Amalni saqlab bo‘lmadi. Qayta urinib ko‘ring."
