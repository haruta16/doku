msgid "RECOVERY_RESULT_TITLE"
msgstr "Resultatet sparades inte"

msgid "RECOVERY_RESULT_BODY"
msgstr "Försök spara det här resultatet igen. Om du stänger återgår du till startskärmen; resultat som inte sparats kan gå förlorade."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Daglig incheckning sparades inte"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Din vinst är sparad. Försök med den dagliga incheckningen igen, eller stäng för att hoppa över den den här gången."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Spelets innehåll kunde inte läsas in. Starta om spelet."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Åtgärden kunde inte sparas. Försök igen."
