msgid "RECOVERY_RESULT_TITLE"
msgstr "Niðurstaðan var ekki vistuð"

msgid "RECOVERY_RESULT_BODY"
msgstr "Reyndu að vista þessa niðurstöðu aftur. Ef þú lokar ferðu aftur á upphafsskjáinn; óvistaðar niðurstöður gætu glatast."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Dagleg innskráning var ekki vistuð"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Sigurinn þinn hefur verið vistaður. Reyndu daglega innskráningu aftur eða lokaðu til að sleppa henni í þetta sinn."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Ekki tókst að hlaða efni leiksins. Endurræstu leikinn."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Ekki tókst að vista aðgerðina. Reyndu aftur."
