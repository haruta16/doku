msgid "RECOVERY_RESULT_TITLE"
msgstr "Rezultat nije spremljen"

msgid "RECOVERY_RESULT_BODY"
msgstr "Pokušajte ponovno spremiti ovaj rezultat. Zatvaranjem se vraćate na početni zaslon; nespremljeni rezultati mogu se izgubiti."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Dnevna prijava nije spremljena"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Vaša pobjeda je spremljena. Ponovite dnevnu prijavu ili zatvorite da biste je ovaj put preskočili."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Sadržaj igre nije se mogao učitati. Ponovno pokrenite igru."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Radnja se nije mogla spremiti. Pokušajte ponovno."
