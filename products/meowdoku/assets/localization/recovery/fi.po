msgid "RECOVERY_RESULT_TITLE"
msgstr "Tulosta ei tallennettu"

msgid "RECOVERY_RESULT_BODY"
msgstr "Yritä tallentaa tämä tulos uudelleen. Sulkeminen palauttaa aloitusnäyttöön; tallentamattomat tulokset voivat kadota."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Päivittäistä kirjautumista ei tallennettu"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Voittosi on tallennettu. Yritä päivittäistä kirjautumista uudelleen tai ohita se tällä kertaa sulkemalla ikkuna."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Pelin sisältöä ei voitu ladata. Käynnistä peli uudelleen."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Toimintoa ei voitu tallentaa. Yritä uudelleen."
