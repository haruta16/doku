msgid "RECOVERY_RESULT_TITLE"
msgstr "Rezultatas neišsaugotas"

msgid "RECOVERY_RESULT_BODY"
msgstr "Pabandykite išsaugoti šį rezultatą dar kartą. Uždarius grįšite į pagrindinį ekraną; neišsaugoti rezultatai gali būti prarasti."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Kasdienis prisijungimas neišsaugotas"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Jūsų pergalė išsaugota. Pakartokite kasdienį prisijungimą arba uždarykite langą, kad šį kartą jį praleistumėte."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Nepavyko įkelti žaidimo turinio. Paleiskite žaidimą iš naujo."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Nepavyko išsaugoti veiksmo. Bandykite dar kartą."
