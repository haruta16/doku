msgid "RECOVERY_RESULT_TITLE"
msgstr "Rezultat ni shranjen"

msgid "RECOVERY_RESULT_BODY"
msgstr "Poskusite znova shraniti ta rezultat. Z zapiranjem se vrnete na začetni zaslon; neshranjeni rezultati se lahko izgubijo."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Dnevna prijava ni shranjena"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "Vaša zmaga je shranjena. Ponovite dnevno prijavo ali zaprite, da jo tokrat preskočite."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Vsebine igre ni bilo mogoče naložiti. Znova zaženite igro."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Dejanja ni bilo mogoče shraniti. Poskusite znova."
