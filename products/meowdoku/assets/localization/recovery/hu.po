msgid "RECOVERY_RESULT_TITLE"
msgstr "Az eredmény nem lett mentve"

msgid "RECOVERY_RESULT_BODY"
msgstr "Próbáld újra menteni ezt az eredményt. Bezáráskor visszatérsz a kezdőképernyőre; a nem mentett eredmények elveszhetnek."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "A napi bejelentkezés nem lett mentve"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "A győzelmed mentve van. Próbáld újra a napi bejelentkezést, vagy zárd be az ablakot, ha most kihagyod."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "Nem sikerült betölteni a játék tartalmát. Indítsd újra a játékot."

msgid "RECOVERY_SAVE_ERROR"
msgstr "Nem sikerült menteni a műveletet. Próbáld újra."
