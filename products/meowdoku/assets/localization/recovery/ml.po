msgid "RECOVERY_RESULT_TITLE"
msgstr "ഫലം സേവ് ചെയ്തിട്ടില്ല"

msgid "RECOVERY_RESULT_BODY"
msgstr "ഈ ഫലം വീണ്ടും സേവ് ചെയ്യാൻ ശ്രമിക്കുക. അടച്ചാൽ ഹോമിലേക്ക് മടങ്ങും; സേവ് ചെയ്യാത്ത ഫലങ്ങൾ നഷ്ടപ്പെട്ടേക്കാം."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "ദിവസേനയുള്ള ചെക്ക്-ഇൻ സേവ് ചെയ്തിട്ടില്ല"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "നിങ്ങളുടെ വിജയം സേവ് ചെയ്തിട്ടുണ്ട്. ചെക്ക്-ഇൻ വീണ്ടും ശ്രമിക്കുക, അല്ലെങ്കിൽ ഇത്തവണ അത് ഒഴിവാക്കാൻ അടയ്ക്കുക."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "ഗെയിമിലെ ഉള്ളടക്കം ലോഡ് ചെയ്യാനായില്ല. ദയവായി ഗെയിം വീണ്ടും ആരംഭിക്കുക."

msgid "RECOVERY_SAVE_ERROR"
msgstr "പ്രവർത്തനം സേവ് ചെയ്യാനായില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."
