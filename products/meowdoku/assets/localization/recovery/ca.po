msgid "RECOVERY_RESULT_TITLE"
msgstr "Resultat no desat"

msgid "RECOVERY_RESULT_BODY"
msgstr "Torna a provar de desar aquest resultat. En tancar, tornaràs a l’inici; els resultats no desats es podrien perdre."

msgid "RECOVERY_CHECKIN_TITLE"
msgstr "Registre diari no desat"

msgid "RECOVERY_CHECKIN_BODY"
msgstr "La teva victòria està desada. Torna a provar el registre diari o tanca per ometre’l aquesta vegada."

msgid "RECOVERY_CONTENT_ERROR"
msgstr "No s’ha pogut carregar el contingut del joc. Reinicia el joc."

msgid "RECOVERY_SAVE_ERROR"
msgstr "No s’ha pogut desar l’acció. Torna-ho a provar."
